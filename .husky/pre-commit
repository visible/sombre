STAGED=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0
UNSTAGED=$(git -c core.quotePath=false diff --name-only)
PARTIAL=""
FULL=$STAGED
if [ -n "$UNSTAGED" ]; then
  PARTIAL=$(printf '%s\n' "$STAGED" | grep -Fx -- "$UNSTAGED" || true)
fi
if [ -n "$PARTIAL" ]; then
  FULL=$(printf '%s\n' "$STAGED" | grep -Fxv -- "$PARTIAL" || true)
fi
CODE=0
git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 bunx ultracite fix || CODE=$?
printf '%s\n' "$FULL" | while IFS= read -r file; do
  [ -f "$file" ] && git add -- "$file"
done
if [ -n "$PARTIAL" ]; then
  echo "Fixes to partially staged files were left unstaged:"
  printf '%s\n' "$PARTIAL" | sed 's/^/  /'
fi
exit $CODE
