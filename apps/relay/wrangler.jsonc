{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "src/index.ts",
  "routes": [{ "pattern": "sombre.si", "custom_domain": true }],
  "workers_dev": false,
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "GATES", "class_name": "Gate" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Gate"] },
  ],
  "observability": { "enabled": true },
}
